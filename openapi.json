  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Opening": {
        "type": "object",
        "required": [
          "customer",
          "vehicle"
        ],
        "properties": {
          "customer": {
            "type": "object",
            "required": [
              "name",
              "documentType",
              "document"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "documentType": {
                "type": "string",
                "enum": [
                  "CPF",
                  "CNPJ"
                ]
              },
              "document": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email",
                "nullable": true
              },
              "phone": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "vehicle": {
            "type": "object",
            "required": [
              "licensePlate",
              "brand",
              "model",
              "year"
            ],
            "properties": {
              "licensePlate": {
                "type": "string"
              },
              "brand": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "year": {
                "type": "integer",
                "minimum": 1900
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "stockItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stockItemId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
